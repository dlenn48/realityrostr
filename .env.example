# Copy this file to .env.local and fill in real values from your Supabase
# project's Settings -> API page. Never commit .env.local — it's already in
# .gitignore.

# Project URL (Settings -> API -> Project URL)
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key — safe to expose in the browser (Settings -> API -> Project API keys).
# Newer Supabase projects call this the "publishable" key; older ones call the
# equivalent value the "anon" key. Either way, this is NOT the secret/service_role key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key — server-only, NEVER prefix with NEXT_PUBLIC_, NEVER expose to the
# browser. Not used by anything in Phase 1; included here so it's obvious where
# it belongs once a Phase 2 admin/server action needs to bypass RLS deliberately.
SUPABASE_SECRET_KEY=
